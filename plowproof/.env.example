# Postgres (Neon, Supabase, or local). Example local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plowproof

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Leave RESEND_API_KEY empty in dev and links print to the terminal.
RESEND_API_KEY=
EMAIL_FROM="PlowProof <no-reply@yourdomain.com>"

# AI-assisted customer import
ANTHROPIC_API_KEY=

# Timezone used for times on server-rendered pages
APP_TIMEZONE=America/Chicago

# Visit photos. "local" writes to ./.data/uploads; "s3" works with Cloudflare R2, AWS S3, or MinIO.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Solana anchoring. Generate the signing key with `npm run solana:keygen`.
# SOLANA_CLUSTER: devnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ANCHOR_SECRET_KEY=

# Text messages (Twilio). Leave empty in dev and texts print to the terminal.
# Use either a phone number (TWILIO_FROM=+1...) or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
