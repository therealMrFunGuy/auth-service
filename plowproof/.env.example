# Postgres (Neon, Supabase, or local). Example local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plowproof

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Leave RESEND_API_KEY empty in dev and links print to the terminal.
RESEND_API_KEY=
EMAIL_FROM="PlowProof <no-reply@yourdomain.com>"

# AI-assisted customer import through OpenRouter (https://openrouter.ai/keys).
# The default model is free; set OPENROUTER_MODEL to use another one.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Timezone used for times on server-rendered pages
APP_TIMEZONE=America/Chicago

# Visit photos. "local" writes to ./.data/uploads; "s3" works with Cloudflare R2, AWS S3, or MinIO;
# "db" stores them in Postgres (the default on Vercel).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Text messages (Twilio). Leave empty in dev and texts print to the terminal.
# Use either a phone number (TWILIO_FROM=+1...) or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
